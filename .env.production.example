APP_NAME=TradeOff
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://tradeoff:change_me@postgres:5432/tradeoff
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/3

JWT_SECRET=replace_with_a_64_character_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://your-domain.example"]

NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1
NEXT_PUBLIC_WS_URL=wss://your-domain.example/ws

POSTGRES_DB=tradeoff
POSTGRES_USER=tradeoff
POSTGRES_PASSWORD=replace_with_strong_db_password

KAFKA_BOOTSTRAP_SERVERS=kafka:9093
ELASTICSEARCH_ENABLED=false
PROMETHEUS_ENABLED=true
OPENTELEMETRY_ENABLED=false

# AI Assistant (OpenRouter — get free key at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...your_key_here
AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# Blockchain (Sepolia testnet — set to enable on-chain settlement)
BLOCKCHAIN_NETWORK=sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
DEPLOYER_PRIVATE_KEY=0x...your_deployer_private_key
